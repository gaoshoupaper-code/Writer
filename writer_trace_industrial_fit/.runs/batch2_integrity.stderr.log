# HTTP 拉取超时：trace 内容可能较大（大 trace 上 MB），给充足余量。
_FETCH_TIMEOUT = 30.0


class NotifyBody(BaseModel):
    """执行端完成通知的请求体。"""
    trace_id: str
    workspace_path: str | None = None
    thread_id: str | None = None
